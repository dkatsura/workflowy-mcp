# Copy to .env.local and fill in values locally. Never commit real credentials.
DATABASE_URL=
WORKFLOWY_API_KEY=
# Generate two distinct values with: openssl rand -hex 32
ADMIN_SECRET=
MCP_ACCESS_SECRET=
# Canonical HTTPS origin. Optional on Vercel when its production URL is available.
OAUTH_ISSUER=
# Optional comma-separated browser origins. This is not authentication.
ALLOWED_ORIGINS=
